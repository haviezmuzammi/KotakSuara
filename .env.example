# Copy to .env and fill in. Never commit .env.
# API_KEY: random string of 24+ chars, shared with the server (n8n + Telegram bot).
API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional overrides (defaults shown)
# HOST=0.0.0.0
# PORT=8780
# DEFAULT_ENGINE=chatterbox_ml
# LOUDNESS_LUFS=-16          # final loudness of every narration; "off" disables
# VOXCPM_PYTHON=D:\CODE_PROJECT\voxcpm-trial\.venv\Scripts\python.exe   # enables engine voxcpm2
# VOXCPM_HF_HOME=D:\CODE_PROJECT\voxcpm-trial\models
# MAX_CHUNK_CHARS=250
# CROSSFADE_MS=50
# AYAT_SILENCE_MS=2000
# STUCK_JOB_SECONDS=900
# ENABLE_UNOFFICIAL_ENGINES=true
# ALLOWED_CLIENTS=127.0.0.1,::1,192.168.1.60   # client IPs allowed by the app (firewall stays the main boundary)
